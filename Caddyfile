{
    # Global options
    auto_https on
    # For production, set auto_https on and use your domain name
}

# HTTP server (port 80)
# For production, replace :80 with your domain name (e.g., yourdomain.com)
toolsforfrontend.com, www.toolsforfrontend.com {
    # Increase body size limit for file uploads
    request_body_max_size 10M

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
    }

    # Placeholder image route - proxy to backend API
    handle /placeholder* {
        rewrite * /api/image/placeholder{path}?{query}
        reverse_proxy backend:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        header Cache-Control "public, max-age=31536000"
    }

    # API routes - proxy to backend
    handle /api* {
        reverse_proxy backend:3001 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Serve static files from client build
    root * /usr/share/caddy

    # Serve static assets with caching
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    }
    handle @static {
        file_server
        header Cache-Control "public, immutable, max-age=31536000"
    }

    # Handle client-side routing - return index.html for all other routes
    try_files {path} /index.html
    file_server
}

# HTTPS server (port 443)
# For production, replace :443 with your domain name (e.g., yourdomain.com)
# When using a domain, Caddy automatically handles both HTTP and HTTPS
toolsforfrontend.com, www.toolsforfrontend.com {
    # For local development with self-signed certificate
#    tls internal
    
    # For production, use automatic Let's Encrypt:
    # tls yourdomain.com
    # Or with DNS challenge:
#     tls {
#         dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#     }

    # Increase body size limit for file uploads
    request_body_max_size 10M

    # Security headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
