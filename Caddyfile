toolsforfrontend.com www.toolsforfrontend.com {
  # Serve static files from client build
  root * /var/www/tools-for-frontend/client/dist

  # Reverse proxy API requests to Node.js server
  handle /api/* {
    reverse_proxy localhost:3001
  }

  # Handle sitemap.xml and robots.txt (served from server for SEO)
  handle /sitemap.xml {
    reverse_proxy localhost:3001
  }
  handle /robots.txt {
    reverse_proxy localhost:3001
  }

  # Handle placeholder route (maps to /api/image/placeholder)
  handle /p/* {
    uri replace /p /api/image/placeholder
    reverse_proxy localhost:3001
  }

  # Serve static files and handle SPA routing
  handle {
    try_files {path} /index.html
    file_server
  }

  # Cache headers for static assets (JS, CSS, images, fonts, etc.)
  @static_assets {
    path /assets/*
    path *.js
    path *.css
    path *.png
    path *.jpg
    path *.jpeg
    path *.gif
    path *.svg
    path *.webp
    path *.woff
    path *.woff2
    path *.ttf
    path *.eot
    path *.ico
  }
  header @static_assets {
    Cache-Control "public, max-age=31536000, immutable"
  }

  # Cache headers for HTML files (shorter cache since they may change)
  @html_files {
    path *.html
  }
  header @html_files {
    Cache-Control "public, max-age=3600"
  }

  # Enable compression
  encode gzip zstd

  # Security headers
  header {
    # Enable HSTS
    Strict-Transport-Security "max-age=31536000;"
    # Prevent clickjacking
    X-Frame-Options "SAMEORIGIN"
    # XSS Protection
    X-Content-Type-Options "nosniff"
    # Referrer Policy
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}